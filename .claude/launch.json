{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "netsim",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "netsim", "-l", "4173"],
      "port": 4173
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    }
  ]
}
